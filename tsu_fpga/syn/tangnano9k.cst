// =============================================================================
// tangnano9k.cst — Physical Constraints for Tang Nano 9K (GW1NR-9C)
// =============================================================================

// System clock 27 MHz
IO_LOC "clk_27" 52;
IO_PORT "clk_27" PULL_MODE=NONE IO_TYPE=LVCMOS33;

// Reset button S1 (active low)
IO_LOC "rst_n" 4;
IO_PORT "rst_n" PULL_MODE=UP IO_TYPE=LVCMOS33;

// UART TX (to USB-UART bridge)
IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" PULL_MODE=NONE IO_TYPE=LVCMOS33;

// RGB LED (active LOW on Tang Nano 9K)
IO_LOC "led_r" 10;
IO_PORT "led_r" PULL_MODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "led_g" 11;
IO_PORT "led_g" PULL_MODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "led_b" 13;
IO_PORT "led_b" PULL_MODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
